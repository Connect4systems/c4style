{
 "doctype": "DocType",
 "name": "Style Settings",
 "module": "C4Style",
 "issingle": 1,
 "track_changes": 1,
 "field_order": [
  "colors_section",
  "palette",
  "primary",
  "accent",
  "background",
  "menu_section",
  "menu_background",
  "menu_text",
  "menu_active",
  "layout_section",
  "font_size",
  "radius",
  "density",
  "header_section",
  "navbar_background",
  "navbar_text",
  "panel_background",
  "table_header_background",
  "table_header_text",
  "navigation_section",
  "brand_name",
  "persistent_menu",
  "font_family",
  "text_direction",
  "preview_section",
  "theme_preview"
 ],
 "fields": [
  {
   "fieldname": "colors_section",
   "fieldtype": "Section Break",
   "label": "Site colors"
  },
  {
   "fieldname": "palette",
   "fieldtype": "Select",
   "label": "Color palette",
   "options": "C4Style\nOcean\nForest\nSunset\nLime Fresh\nWine\nCustom",
   "default": "C4Style"
  },
  {
   "fieldname": "primary",
   "fieldtype": "Color",
   "label": "Primary color",
   "default": "#714B67",
   "reqd": 1
  },
  {
   "fieldname": "accent",
   "fieldtype": "Color",
   "label": "Accent color",
   "default": "#017E84",
   "reqd": 1
  },
  {
   "fieldname": "background",
   "fieldtype": "Color",
   "label": "Page background",
   "default": "#E5E8EB",
   "reqd": 1
  },
  {
   "fieldname": "menu_section",
   "fieldtype": "Section Break",
   "label": "Menu colors"
  },
  {
   "fieldname": "menu_background",
   "fieldtype": "Color",
   "label": "Menu background",
   "default": "#FFFFFF",
   "reqd": 1
  },
  {
   "fieldname": "menu_text",
   "fieldtype": "Color",
   "label": "Menu text and icons",
   "default": "#36414C",
   "reqd": 1
  },
  {
   "fieldname": "menu_active",
   "fieldtype": "Color",
   "label": "Selected menu item",
   "default": "#E5F1F1",
   "reqd": 1
  },
  {
   "fieldname": "layout_section",
   "fieldtype": "Section Break",
   "label": "Layout"
  },
  {
   "fieldname": "font_size",
   "fieldtype": "Int",
   "label": "Text size (12 to 18 px)",
   "default": 14,
   "reqd": 1
  },
  {
   "fieldname": "radius",
   "fieldtype": "Int",
   "label": "Corner roundness (2 to 16 px)",
   "default": 6,
   "reqd": 1
  },
  {
   "fieldname": "density",
   "fieldtype": "Select",
   "label": "Control spacing",
   "options": "comfortable\ncompact",
   "default": "comfortable",
   "reqd": 1
  },
  {
   "fieldname": "header_section",
   "fieldtype": "Section Break",
   "label": "Header, cards and tables"
  },
  {
   "fieldname": "navbar_background",
   "fieldtype": "Color",
   "label": "Header background",
   "default": "#714B67",
   "reqd": 1
  },
  {
   "fieldname": "navbar_text",
   "fieldtype": "Color",
   "label": "Header text and icons",
   "default": "#FFFFFF",
   "reqd": 1
  },
  {
   "fieldname": "panel_background",
   "fieldtype": "Color",
   "label": "Card and form background",
   "default": "#FFFFFF",
   "reqd": 1
  },
  {
   "fieldname": "table_header_background",
   "fieldtype": "Color",
   "label": "Table header background",
   "default": "#714B67",
   "reqd": 1
  },
  {
   "fieldname": "table_header_text",
   "fieldtype": "Color",
   "label": "Table header text",
   "default": "#FFFFFF",
   "reqd": 1
  },
  {
   "fieldname": "navigation_section",
   "fieldtype": "Section Break",
   "label": "Navigation and typography"
  },
  {
   "fieldname": "brand_name",
   "fieldtype": "Data",
   "label": "Menu brand name",
   "default": "C4Style",
   "reqd": 1
  },
  {
   "fieldname": "persistent_menu",
   "fieldtype": "Check",
   "label": "Show workspace menu on every Desk page",
   "default": "1",
   "description": "Uses only workspaces already permitted for the signed-in user."
  },
  {
   "fieldname": "font_family",
   "fieldtype": "Select",
   "label": "Font family",
   "options": "system\narial\ntahoma\ngeorgia",
   "default": "system",
   "reqd": 1
  },
  {
   "fieldname": "text_direction",
   "fieldtype": "Select",
   "label": "Default text direction",
   "options": "auto\nltr\nrtl",
   "default": "auto",
   "reqd": 1
  },
  {
   "fieldname": "preview_section",
   "fieldtype": "Section Break",
   "label": "Preview"
  },
  {
   "fieldname": "theme_preview",
   "fieldtype": "HTML"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Website Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
